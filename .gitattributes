# Disables automatic detection of text files
* text=false

# Source code
*.css             eol=lf
*.df              eol=lf
*.htm             eol=lf
*.html            eol=lf
*.java            eol=lf
*.js              eol=lf
*.json            eol=lf
*.jsp             eol=lf
*.jspf            eol=lf
*.jspx            eol=lf
*.jsx             eol=lf
*.mjs             eol=lf
*.properties      eol=lf
*.sh              eol=lf
*.sql             eol=lf
*.tld             eol=lf
*.ts              eol=lf
*.tsx             eol=lf
*.txt             eol=lf
*.tag             eol=lf
*.tagx            eol=lf
*.xml             eol=lf
*.yaml            eol=lf
*.yml             eol=lf

# Repository configuration files
.gitignore        eol=lf
.gitattributes    eol=lf

# Binary files
*.class           binary
*.dll             binary
*.ear             binary
*.gif             binary
*.ico             binary
*.jar             binary
*.jpg             binary
*.jpeg            binary
*.png             binary
*.so              binary
*.war             binary
